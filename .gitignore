# Clones upstream locais (pesados) - NAO versionar.
# Somente as customizacoes em custom/ sao rastreadas neste repo.
/canary/
/otclient/

# Logs e arquivos temporarios de build
*.log
configure_log.txt

# Segredos e dados internos - NUNCA versionar (ficam so locais)
/custom/canary/config.lua
/custom/canary/create_tiozao_account.sql
/custom/canary/.agents/

# Snapshot local completo do Canary: backups e material privado ficam locais.
*.old
*.old.*
/custom/canary/config.lua_old*
/custom/canary/key.pem
/custom/canary/cache/
/custom/canary/data/scripts/talkactions/player/.tools/
/custom/canary/data/scripts/talkactions/player/.vs/

# Copias acidentais de metadados e gravacoes locais.
/custom/canary/data/scripts/talkactions/player/.github/
/custom/otclient/records/*.cam

# Backups locais de executaveis e simbolos com sufixo _old.
/custom/canary/*.exe_old*
/custom/canary/*.pdb_old*
