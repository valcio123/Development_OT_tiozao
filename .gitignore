# Projeto ativo: fontes em canary/ e otclient/ sao versionadas.

# Logs e arquivos temporarios de build
*.log
configure_log.txt

# Segredos e dados internos - NUNCA versionar (ficam so locais)
/canary/config.lua
/canary/create_tiozao_account.sql
/canary/.agents/

# Snapshot local completo do Canary: backups e material privado ficam locais.
*.old
*.old.*
/canary/config.lua_old*
/canary/key.pem
/canary/cache/
/canary/data/scripts/talkactions/player/.tools/
/canary/data/scripts/talkactions/player/.vs/

# Copias acidentais de metadados e gravacoes locais.
/canary/data/scripts/talkactions/player/.github/
/otclient/records/*.cam

# Backups locais de executaveis e simbolos com sufixo _old.
/canary/*.exe_old*
/canary/*.pdb_old*

# Artefatos locais de execucao e backup - NAO versionar.
/site/storage/
/backups/

# Agents instructions and project memory are local-only.
/.agents/
/**/AGENTS.md
/**/Agents_*.md
/**/OT_Tiozao_CONTINUIDADE.md

# Ferramentas, configuracoes pessoais e dados de execucao locais.
.tools/
.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example
!.env.*.example
/canary/database_backup/
/otclient/config.ini
/otclient/cache/
*.exe_old*
*.pdb_old*

# Templates publicos e backups antigos.
!.env.dist
*_old
*_old.*

# Development combat captures and CSV reports remain local.
/canary/logs/combat-telemetry/

# Python bytecode caches are generated locally.
__pycache__/
*.py[cod]
